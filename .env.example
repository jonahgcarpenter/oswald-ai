# Oswald AI environment example
# Copy values into your local .env or runtime environment and fill secrets as needed.

# Optional Home Assistant gateway
# Enables /homeassistant/ws only when values are set and valid.
# Enter the same token in the HACS integration.
# Generate with: openssl rand -hex 32
HOME_ASSISTANT_AUTH_TOKEN=
HOME_ASSISTANT_LISTEN_PORT=8000

# Optional iMessage gateway
# Enables /bluebubbles/webhook only when values are set and valid.
BLUEBUBBLES_LISTEN_PORT=8090
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# Optional Discord gateway
# Enables Discord only when value is set.
DISCORD_TOKEN=

# MCP URL and header encryption (server descriptions are stored as plaintext model metadata)
# Generate with: openssl rand -base64 32
MCP_CONFIG_ENCRYPTION_KEY=

# LLM gateway
LLM_GATEWAY_URL=http://localhost:8080
LLM_GATEWAY_MODEL=
# Optional semantic channel for hybrid durable-memory recall; FTS5 remains available without it.
LLM_GATEWAY_EMBEDDING_MODEL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_VIRTUAL_KEY=
LLM_GATEWAY_TIMEOUT=180s

# Optional model budget overrides
# Leave as 0 to use discovered model metadata or package defaults.
MODEL_CONTEXT_WINDOW=0
MODEL_MAX_OUTPUT_TOKENS=0

# Web search backend
SEARXNG_URL=http://localhost:8080

# Runtime behavior
WORKER_POOL_SIZE=1
MAX_TOOL_FAILURE_RETRIES=3
MAX_TOOL_CALLS_PER_REQUEST=12
MAX_TOOL_ITERATIONS_PER_REQUEST=8
LOG_LEVEL=info

# Memory retention and maintenance
# Durations use Go duration syntax. All values must be positive.
# Dead-job retention must be at least successful-job retention; optimize interval
# must be at least maintenance interval.
# Retain retired or failed generated index tables this long before dropping them.
MEMORY_RETIRED_INDEX_RETENTION=168h
# Expire an active session after this much inactivity.
MEMORY_SESSION_INACTIVITY=24h
# Mark turns with no delivery outcome as failed after this timeout.
MEMORY_PENDING_DELIVERY_TIMEOUT=15m
# Retain successful or skipped background jobs this long.
MEMORY_SUCCESSFUL_JOB_RETENTION=168h
# Retain permanently failed background jobs this long.
MEMORY_DEAD_JOB_RETENTION=720h
# Retain expired account-link challenges for this additional cleanup grace period.
MEMORY_ACCOUNT_CHALLENGE_GRACE=24h
# Run retention, consistency, index-hygiene, and SQLite maintenance at this interval.
MEMORY_MAINTENANCE_INTERVAL=1h
# Wait at least this long between SQLite PRAGMA optimize operations.
MEMORY_DATABASE_OPTIMIZE_INTERVAL=24h
# Process at most this many rows per maintenance category in one sweep.
MEMORY_MAINTENANCE_BATCH_SIZE=100
