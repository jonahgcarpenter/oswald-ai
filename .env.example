# Oswald AI environment example
# Copy values into your local .env or runtime environment and fill secrets as needed.

# Optional Home Assistant gateway
# Enables /homeassistant/ws only when values are set and valid.
# Enter the same token in the HACS integration.
# Generate with: openssl rand -hex 32
HOME_ASSISTANT_AUTH_TOKEN=
HOME_ASSISTANT_LISTEN_PORT=8000

# Optional iMessage gateway
# Enables /bluebubbles/webhook only when values are set and valid.
BLUEBUBBLES_LISTEN_PORT=8090
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# When true, iMessage DMs require <@Oswald>, @Oswald, or Oswald; groups keep their existing rules.
BLUEBUBBLES_DM_MENTION=false

# Optional Discord gateway
# Enables Discord only when value is set.
DISCORD_TOKEN=

# Optional OpenAI-compatible inbound API. Binds to 127.0.0.1 only.
# No authentication: enabling this listener creates a persistent administrator.
# Any local process or proxy that can reach the port can act as that administrator.
OPENAI_LISTEN_PORT=

# MCP URL and header encryption (server descriptions are stored as plaintext model metadata)
# Generate with: openssl rand -base64 32
MCP_CONFIG_ENCRYPTION_KEY=

# LLM gateway
# Chat uses streaming internally on every gateway; iMessage delivers only the final response.
# Bifrost must have a Logs Store enabled for async embeddings when configured.
# Configure the provider timeout in Bifrost; Oswald does not impose a generation timeout.
LLM_GATEWAY_URL=http://localhost:8080
LLM_GATEWAY_MODEL=
# Retained legacy semantic-retrieval setting; active file memory does not use embeddings.
LLM_GATEWAY_EMBEDDING_MODEL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_VIRTUAL_KEY=

# Model context window used for prompt budgeting; 0 selects the 32768-token fallback.
MODEL_CONTEXT_WINDOW=0

# Optional web providers. web_search is disabled when both are empty.
# Brave is primary when configured; SearXNG is the free fallback when both are set.
BRAVE_API_KEY=
SEARXNG_URL=

# Optional first-party ComfyUI image generation. The tool is disabled when URL is empty.
COMFYUI_URL=http://comfyui:8188
# Workflows use fixed SD3.5 Large Turbo GGUF, CLIP-L, T5 GGUF, and SD3 VAE models.
COMFYUI_GENERATION_TIMEOUT=2m

# Runtime behavior
WORKER_POOL_SIZE=1
LOG_LEVEL=info
